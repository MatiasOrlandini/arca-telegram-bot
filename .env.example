# Crear el bot en @BotFather. No compartir el token ni la clave privada.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789

# PostgreSQL 14+; usar una base existente dedicada al bot.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/arca_bot
DATABASE_SSL=false

ARCA_ENV=homologacion
ARCA_CUIT=
ARCA_PUNTO_VENTA=1
ARCA_CERT_PATH=certs/homologacion.crt
ARCA_KEY_PATH=certs/homologacion.key

# Opcionales: el bot consulta el padrón A5 al iniciar y pide faltantes por Telegram.
# Autorizar ws_sr_padron_a5 para el certificado. Los valores de .env tienen prioridad.
EMISOR_RAZON_SOCIAL=
EMISOR_DOMICILIO=
EMISOR_IIBB=
EMISOR_INICIO_ACTIVIDADES=
DATA_DIR=data

# Opcionales: /factura_fija. Solo pide importe y fechas; concepto fijo Servicios.
RECEPTOR_CUIT=
RECEPTOR_RAZON_SOCIAL=
RECEPTOR_DOMICILIO=
RECEPTOR_IVA_ID=
FACTURA_FIJA_DESCRIPCION=
FACTURA_FIJA_FORMA_PAGO=Contado
